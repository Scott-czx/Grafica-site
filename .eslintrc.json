{
  "env": {
    "browser": true,
    "es2022": true
  },
  "globals": {
    "firebase": "readonly",
    "InkFlowStore": "readonly",
    "InkFlowCatalog": "readonly",
    "InkFlowDemo": "readonly",
    "InkFlowAudio": "readonly"
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "indent": "off",
    "linebreak-style": ["error", "unix"],
    "quotes": [
      "error",
      "single",
      {
        "avoidEscape": true,
        "allowTemplateLiterals": true
      }
    ],
    "semi": ["error", "always"],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-undef": "error",
    "no-redeclare": "error",
    "prefer-const": "error",
    "no-var": "error",
    "object-shorthand": "error",
    "prefer-arrow-callback": "error",
    "arrow-spacing": "error",
    "no-duplicate-imports": "error",
    "no-useless-rename": "error"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js", "scripts/**/*.js"],
      "env": {
        "node": true
      }
    }
  ]
}
